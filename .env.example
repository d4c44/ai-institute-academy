# Next.js frontend. Copy to .env (git-ignored).

# Where the Next.js server reaches the Go API (Docker: http://api:8080). It is also baked into the
# build (the /api/v1 rewrite), so it must be set for `next build` too.
API_URL="http://localhost:8080"

# Public base URL of the site; certificate QR codes point at ${APP_URL}/verify/<code>.
APP_URL="http://localhost:3000"