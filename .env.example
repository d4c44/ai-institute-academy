# Next.js frontend. Copy to .env (git-ignored).

# Where the Next.js server reaches the Go API (Docker: http://api:8080).
# While this is unset, `npm run dev` runs in DEMO mode: the site serves its own in-memory API,
# so you can sign in without Go or PostgreSQL (login demo / password Demo-2026!).
# Uncomment it to use the real backend; DEMO_MODE=0 forces the real API too.
# API_URL="http://localhost:8080"

# Public base URL of the site; certificate QR codes point at ${APP_URL}/verify/<code>.
APP_URL="http://localhost:3000"