{
  "name": "AI Institute Academy",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Site", "onAutoForward": "openBrowser" },
    "8080": { "label": "Go API (internal)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "bradlc.vscode-tailwindcss"]
    }
  }
}
