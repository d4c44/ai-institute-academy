# Copy to /opt/ai-academy/.env on the server (next to docker-compose.yml). Never commit the real file.

# Public address of the site, no trailing slash. Certificate QR codes point at ${APP_URL}/verify/<code>.
# With a domain: https://academy.example.kz     Without one yet: http://<server IP>
APP_URL=http://203.0.113.10

# Caddy: the bare domain name enables automatic HTTPS (DNS must already point at the server).
# Leave it as ":80" to serve plain HTTP on the server's IP.
SITE_ADDRESS=:80

# Choose a long random password: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Optional.
# POSTGRES_USER=ai_institute
# POSTGRES_DB=ai_institute
# REGISTRY=ghcr.io/d4c44/ai-institute-academy
# TAG=latest       # the deploy workflow sets this to the commit it deployed
